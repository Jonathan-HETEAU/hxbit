package hxbit;

#if !macro

/**
	The marking parameters of `AnySerializable.markReferences`: `set` is the bits set on the marked objects (`__mark`), `mask` the bits kept.
**/
abstract MarkInfo(Int) {
	/**
		The bits set on the marked objects.
	**/
	public var set(get,never) : Int;
	/**
		The bits of `__mark` kept when marking an object.
	**/
	public var mask(get,never) : Int;
	/**
		Creates the marking parameters.
	**/
	public inline function new(set:Int,mask:Int) {
		this = set | (mask << 16);
	}
	inline function get_set() return this & 0xFFFF;
	inline function get_mask() return this >>> 16;
	#if hxbit_clear
	/**
		The bit telling `AnySerializable.clearReferences` to remove the references to an object.
	**/
	public var clear(get,never) : Int;
	inline function get_clear() return 0x80000000;
	#end
}

/**
	The visibility groups of the objects, by UID, used when marking the references visible from a client (`null` for all the references).
**/
abstract MarkParam(Serializer.UIDMap<Int>) from Serializer.UIDMap<Int> {
	/**
		Returns the visibility groups of the object (`-1` for all groups).
	**/
	public inline function get( v : NetworkSerializable ) return this == null ? -1 : this.get(v.__uid);
}

/**
	A value serialized by a `Serializer`: a `Serializable` object, or a `StructSerializable` structure.
**/
interface AnySerializable {
	#if (hxbit_visibility || hxbit_mark)
	/**
		Marks this object and the objects it references, by setting `mark.set` in their `__mark` field (with `-D hxbit_mark` or `-D hxbit_visibility`). Generated by the macro.
	**/
	public function markReferences( mark : MarkInfo, from : MarkParam ) : Void;
	#end
	#if hxbit_clear
	/**
		Removes the references to the objects having the `mark.clear` bit in their `__mark` field, in this object and the objects it references (with `-D hxbit_clear`). Generated by the macro.
	**/
	public function clearReferences( mark : MarkInfo ) : Void;
	#end
	/** Returns the unique class id for this object **/
	public function getCLID() : Int;
	/** Serialize the object id and fields using this Serializer **/
	public function serialize( ctx : Serializer ) : Void;
	/** Used internaly by unserializer **/
	public function unserializeInit() : Void;
	/** Unserialize object fields using this Serializer **/
	public function unserialize( ctx : Serializer ) : Void;
	/** Returns the object data schema **/
	public function getSerializeSchema( ?forSave: Bool = true ) : Schema;
}

/**
	An object serialized by a `Serializer`: its fields marked with `@:s` are serialized, by code generated at compile time
	(`hxbit.Macros.buildSerializable`). The fields of this interface are generated by the macro.

	The constructor is not called when unserializing: the fields that are not serialized get their initial value
	(`var x : Array<Int> = []`). Optional `customSerialize(ctx)` and `customUnserialize(ctx)` methods can (un)serialize
	unsupported values.
**/
@:autoBuild(hxbit.Macros.buildSerializable())
interface Serializable extends AnySerializable {
	#if (hxbit_visibility || hxbit_mark || hxbit_clear)
	/**
		The marking bits, used by `markReferences` and `clearReferences`.
	**/
	public var __mark : Int;
	#end
	/** Unique identifier for the object, automatically set on new() **/
	public var __uid : UID;
}

/**
	The serializer generated for the enum `T` (in the `hxbit.enumSer` package), with static methods to serialize, unserialize and get the schema of its values.
**/
@:genericBuild(hxbit.Macros.buildSerializableEnum())
class SerializableEnum<T> {
}

#end

