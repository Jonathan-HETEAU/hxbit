package hxbit;

/**
	An object notified when a value it contains is modified: a `NetworkSerializable`, or a proxy containing other proxies.
**/
interface ProxyHost {
	/**
		Marks the property `bit` as changed, if its send conditions (`@:increment`, `@:condSend`) allow it.
	**/
	public function networkSetBitCond( bit : Int ) : Void;
}

/**
	A proxy, wrapping a mutable value stored in a property of a `ProxyHost`.
**/
interface ProxyChild {
	/**
		Binds the proxy to the property `bit` of its host. Throws if it is already bound to another property.
	**/
	public function bindHost( p : ProxyHost, bit : Int ) : Void;
	/**
		Unbinds the proxy from its host.
	**/
	public function unbindHost() : Void;
}

/** Classes implementing this will not be replicated over the network **/
interface NetworkNoReplication { }

/**
	The operations a client can be allowed to do on an object, checked with `NetworkSerializable.networkAllow`.
**/
enum abstract Operation(Int) {
	/**
		Allows initiating RPC on client side (only "normal" and "owner" rpc are checked against it).
	**/
	public var RPC = 0;
	/**
		Tells if the client is allowed to call a rpc(server) for this object
	**/
	public var RPCServer = 1;
	/**
		Tells if the client is allowed to call a rpc(owner) for this object
	**/
	public var RPCOwner = 6;
	/**
		Tells if the client is to be the target of the rpc(owner) messages
	**/
	public var Ownership = 2;
	/**
		Tells if the client is allowed to set fields for this object
	**/
	public var SetField = 3;
	/**
		Tells if the client is allowed to enable replication for this object
	**/
	public var Register = 4;
	/**
		Tells if the client is allowed to disable replication for this object
	**/
	public var Unregister = 5;
}

/**
	A `Serializable` object that can be replicated over the network by a `NetworkHost`: its `@:s` fields are synchronized from
	the authority to the clients, and its `@:rpc` methods are remote procedure calls (see the README for the RPC modes and
	the `@:increment`, `@:condSend`, `@:notMutable`, `@:noSync`, `@:noSave` and `@:visible` field metadata).

	The macro generates the fields of this interface, a `networkProp<Name>` constant for each field (see
	`networkCancelProperty`) and `networkLocalChange(f)`, which runs `f` without sending the changes.
	Set `enableReplication` to share the object: `alive` is then called on the clients when it is received.
**/
#if !hxbit_manual_build
@:autoBuild(hxbit.Macros.buildNetworkSerializable())
#end
interface NetworkSerializable extends Serializable extends ProxyHost {
	/**
		The host replicating the object, or `null`.
	**/
	public var __host : NetworkHost;
	/**
		The changed properties `0` to `29`, as bits.
	**/
	public var __bits1 : Int;
	/**
		The changed properties `30` and above, as bits.
	**/
	public var __bits2 : Int;
	/**
		The next object of the list of changed objects of the host (or the object itself when `enableAutoReplication` is set).
	**/
	public var __next : NetworkSerializable;
	/**
		Shares the object with the current `NetworkHost` when set, and stops sharing it when unset.
	**/
	public var enableReplication(get, set) : Bool;
	/**
		Shares the object automatically when it is first sent over the network (as a value of a replicated object).
	**/
	public var enableAutoReplication(get, set) : Bool;
	/**
		Called on the clients when the object has been received and fully initialized, and by `NetworkHost.makeAlive` after loading a state. Sets `enableReplication` by default: define it to do your initialization.
	**/
	public function alive() : Void; // user defined

	/**
		Writes the changed properties and clears their bits. Generated by the macro.
	**/
	public function networkFlush( ctx : Serializer ) : Void;
	/**
		Reads the changed properties. Generated by the macro.
	**/
	public function networkSync( ctx : Serializer ) : Void;
	/**
		Reads the arguments of the RPC `rpcID` and executes it. Generated by the macro.
	**/
	public function networkRPC( ctx : NetworkSerializer, rpcID : Int, clientResult : NetworkHost.NetworkClient ) : Bool;
	/**
		Tells if the client (the owner object of a `NetworkClient`) is allowed to do the operation, on the property or RPC `propId`. Returns `false` by default: define it to give rights to the clients.
	**/
	public function networkAllow( op : Operation, propId : Int, client : NetworkSerializable ) : Bool;
	/**
		Returns the name of a property, or of a RPC if `isRPC` is set. Generated by the macro.
	**/
	public function networkGetName( propId : Int, isRPC : Bool = false ) : String;
	/**
		Marks the property `bit` as changed, to be sent at the next `NetworkHost.flush`. Generated by the macro.
	**/
	public function networkSetBit( bit : Int ) : Void;

	/**
		Returns the schema of the RPCs. Generated by the macro.
	**/
	public function getRPCSchema() : Schema;

	#if hxbit_visibility
	/**
		The visibility groups to evaluate again, as bits.
	**/
	public var __dirtyVisibilityGroups : Int;
	/**
		The number of clients the object was sent to, minus one.
	**/
	public var __visibilityCount : Int;
	/**
		Tells if the properties of the visibility group are visible to the client (the owner object of a `NetworkClient`). Returns `false` by default.
	**/
	public function evalVisibility( group : VisibilityGroup, from : NetworkSerializable ) : Bool;
	/**
		Requests a new evaluation of the visibility group, for example when the result of `evalVisibility` changed. Generated by the macro.
	**/
	public function setVisibilityDirty( group : VisibilityGroup ) : Void;
	/**
		Returns the properties visible with the visibility groups `groups`, as bits. Generated by the macro.
	**/
	public function getVisibilityMask( groups : Int ) : haxe.Int64;
	#end
	/**
		Returns the `@:noSave` properties, as bits. Generated by the macro.
	**/
	public function getNoSaveMask() : haxe.Int64;
}

/**
	The base class of the generated proxies.
**/
class BaseProxy implements ProxyHost implements ProxyChild {
	/**
		The host of the proxy, or `null`.
	**/
	public var obj : ProxyHost;
	/**
		The property of the host containing the proxy.
	**/
	public var bit : Int;
	@:noCompletion public inline function networkSetBitCond(_) {
		mark();
	}
	/**
		Marks the property of the host as changed.
	**/
	public inline function mark() {
		if( obj != null ) obj.networkSetBitCond(bit);
	}
	/**
		Binds the proxy to the property `bit` of its host. Throws if it is already bound to another property.
	**/
	public function bindHost(o, bit) {
		if( obj != null && (o != this.obj || bit != this.bit) )
			throw "Binding proxy twice";
		this.obj = o;
		this.bit = bit;
	}
	/**
		Unbinds the proxy from its host.
	**/
	public function unbindHost() {
		this.obj = null;
	}
	/**
		Returns a description of the fields of a structure proxy.
	**/
	public static function objToString(o:Dynamic) {
		var fl = Reflect.fields(o);
		fl.remove("obj");
		fl.remove("bit");
		for( f in fl.copy() )
			if( StringTools.startsWith(f, "__ref_") || Reflect.field(o, f) == null )
				fl.remove(f);
		return "{" + [for( f in fl ) f + " : " + Reflect.field(o, f)].join(",") + "}";
	}
}

/**
	A property of a `NetworkSerializable`, as the `networkProp<Name>` constants: they can be combined with `|`.
**/
abstract NetworkProperty(Int) {

	/**
		Creates the property of the given index.
	**/
	public inline function new(x:Int) {
		this = x;
	}

	/**
		Returns the index of the property.
	**/
	public inline function toInt() {
		return this;
	}

	@:op(a|b) inline function opOr(a:NetworkProperty) return new NetworkProperty(this | a.toInt());

}

/**
	The `Serializer` of a `NetworkHost` and of its clients: it writes the `@:noSave` fields (`forSave` is `false`), shares the objects with `enableAutoReplication` when they are sent, and checks that the referenced objects are known.
**/
class NetworkSerializer extends Serializer {

	var hasError = false;

	/**
		Checks the references: when set, the objects sent must be replicated, and unknown references set `error`.
	**/
	public var enableChecks = true;
	/**
		Tells if an unknown reference was read since the last read of this property (reading it clears it).
	**/
	public var error(get, never) : Bool;
	/**
		The property being synchronized when the last unknown reference was read, or `-1`.
	**/
	public var errorPropId : Int = -1;
	#if hxbit_visibility
	/**
		The client (owner object) data is written for, to evaluate the visibility, or `null`.
	**/
	public var currentTarget : NetworkSerializable;
	/**
		The visibility groups of the objects sent to the client, by UID.
	**/
	public var cachedVisibility : Serializer.UIDMap<Int>;
	#end
	var host : NetworkHost;

	/**
		Creates the serializer of the host.
	**/
	public function new(host) {
		super();
		this.host = host;
		forSave = false;
	}

	function get_error() {
		if( !hasError )
			return false;
		hasError = false;
		return true;
	}

	#if hxbit_visibility
	static var GROUPS = VisibilityGroup.createAll();
	static var GROUP_BITS = GROUPS.length < 16 ? GROUPS.length : 16;
	static var BITS_CACHE : Array<Null<Int>> = [for( i in 0...(1 << GROUP_BITS) ) i];
	/**
		The visibility groups used when there is no `currentTarget`.
	**/
	public var defaultVisibilityMask = 0;
	override function evalVisibility(ns:NetworkSerializable):Int {
		if( currentTarget == null )
			return defaultVisibilityMask;
		var v = cachedVisibility.get(ns.__uid);
		var bits : Int, mask : Int;
		if( v != null ) {
			mask = ns.__dirtyVisibilityGroups;
			if( mask == 0 ) return v;
			bits = v & ~mask;
		} else {
			bits = 0;
			mask = -1;
		}
		var groups = GROUPS;
		for( i in 0...groups.length )
			if( mask & (1<<i) != 0 && ns.evalVisibility(groups[i], currentTarget) )
				bits |= 1 << i;
		if( v == null || (v:Int) != bits )
			cachedVisibility.set(ns.__uid, (bits >>> GROUP_BITS) == 0 ? BITS_CACHE[bits] : bits);
		return bits;
	}
	#end

	override function addAnyRef(s:Serializable) {
		if(Std.isOfType(s, NetworkNoReplication))
			s = null;
		super.addAnyRef(s);
	}

	override function addKnownRef(s:Serializable) {
		if(Std.isOfType(s, NetworkNoReplication))
			s = null;
		super.addKnownRef(s);
	}

	override function onNewObject(i:Serializable) {
		@:privateAccess host.onNewObject(i);
	}

	override function onAddNewObject(i:Serializable) {
		@:privateAccess host.onAddNewObject(i);
	}

	/**
		Called when an object which is not replicated is sent. Throws by default; it can set `enableAutoReplication` to share the object instead.
	**/
	public static dynamic function onUnboundObject(ns:NetworkSerializable) {
		throw "Can't send unbound object " + ns + " over network";
	}

	override function addObjRef(s:Serializable) {
		if( !enableChecks ) {
			super.addObjRef(s);
			return;
		}
		addUID(s.__uid);
		var ns = Std.downcast(s, NetworkSerializable);
		if( ns != null && ns.__host == null ) {
			if( ns.enableAutoReplication ) {
				ns.__next = null;
				ns.__host = host;
			} else {
				var prev = out;
				out = new haxe.io.BytesBuffer(); // prevent garbaged data from being kept if exception raised
				onUnboundObject(ns);
				// allow to keep going after logging message
				if( ns.enableAutoReplication ) {
					out = prev;
					ns.__next = null;
					ns.__host = host;
				} else {
					throw "assert";
				}
			}
		}
		addBool( refs.exists(s.__uid) );
	}

	override function getObjRef() {
		if( !enableChecks )
			return super.getObjRef();
		var id = getUID();
		if( id == 0 ) return 0;
		var b = getBool();
		if( b && !refs.exists(id) ) {
			hasError = true;
			errorPropId = host == null ? -1 : @:privateAccess host.isSyncingProperty;
			return 0;
		}
		return id;
	}

}
