package hxbit;

/**
	The read-only version of the type `T`, generated by a macro: arrays, maps, vectors and structures are replaced by read-only types, recursively.
**/
@:genericBuild(hxbit.Macros.buildReadOnly())
class ReadOnly<T> {
}

/**
	A read-only array.
**/
typedef ReadOnlyArray<T> = haxe.ds.ReadOnlyArray<T>;

/**
	A read-only `haxe.ds.Vector`.
**/
@:forward(get, length, toArray, copy, join, map)
abstract ReadOnlyVector<T>(haxe.ds.Vector<T>) from haxe.ds.Vector<T> {
}

/**
	A read-only `Map`.
**/
@:forward(get, exists, keys, iterator, keyValueIterator, copy, toString)
abstract ReadOnlyMap<K,V>(Map<K,V>) from Map<K,V> {
}
